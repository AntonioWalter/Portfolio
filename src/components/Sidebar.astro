---
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface NavItem {
  label: string;
  href: string;
  key: string;
}

interface Props {
  currentPath?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { currentPath = Astro.url.pathname } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // Remove trailing slash

const navItems: { label: string; href: string; key: string; icon: string }[] = [
  { 
    label: 'Home', 
    href: '/', 
    key: 'nav.home',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  },
  { 
    label: 'Projects', 
    href: '/projects', 
    key: 'nav.projects',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`
  },
  { 
    label: 'Awards', 
    href: '/awards', 
    key: 'nav.awards',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>`
  },
  { 
    label: 'Skills', 
    href: '/skills', 
    key: 'nav.skills',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 8.83 12 13.71 20.71 8.83"/><line x1="12" x2="12" y1="22" y2="13.71"/><line x1="8" x2="8" y1="3.5" y2="5.5"/><line x1="16" x2="16" y1="3.5" y2="5.5"/></svg>`
  },
];

function getLocalizedPath(path: string, l: string) {
  const isIt = l === 'it';
  // Remove base and trailing slash 
  let cleanPath = path.replace(new RegExp(`^${base}`), '').replace(/\/$/, '') || '/';
  
  // If current path has /it, strip it
  if (cleanPath.startsWith('/it')) {
    cleanPath = cleanPath.substring(3) || '/';
  }
  
  // If target is IT, add base + /it
  if (isIt) {
    return cleanPath === '/' ? `${base}/it` : `${base}/it${cleanPath}`;
  }
  // If target is EN (default), return base + cleanPath
  return cleanPath === '/' ? `${base}/` : `${base}${cleanPath}`;
}
---

<aside class="profile-card">
  <!-- Profile Section -->
  <div class="profile-header">
    <div class="profile-image">
      <img 
        src={`${import.meta.env.BASE_URL}profilo.png`}
        alt="Antonio Walter" 
        class="profile-placeholder" 
        onerror="this.src='https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?fit=crop&w=300&h=300'"
      />
    </div>
    
    <div class="profile-info">
      <h1 class="profile-name">Antonio Walter De Fusco</h1>
      <p class="profile-title">{t('role')}</p>
      <p class="profile-location">{t('location')}</p>
      
      <!-- Desktop Language Switcher (Visible on Desktop only) -->
      <div class="lang-switch-desktop">
        <a href={getLocalizedPath(Astro.url.pathname, 'it')} class:list={['lang-btn', { active: lang === 'it' }]}>IT</a>
        <span class="divider">/</span>
        <a href={getLocalizedPath(Astro.url.pathname, 'en')} class:list={['lang-btn', { active: lang === 'en' }]}>EN</a>
      </div>
    </div>
  </div>
  
  <!-- Navigation -->
  <nav class="profile-nav">
    {navItems.map((item) => {
        const localizedHref = lang === 'it' 
            ? (item.href === '/' ? `${base}/it` : `${base}/it${item.href}`) 
            : (item.href === '/' ? `${base}/` : `${base}${item.href}`);
            
        // Check active state smartly
        const isActive = currentPath === localizedHref || 
                         (localizedHref !== '/' && localizedHref !== '/it' && currentPath.startsWith(localizedHref));
        
        return (
          <a 
            href={localizedHref} 
            class:list={['nav-item', { active: isActive }]}
          >
            <span class="nav-icon" set:html={item.icon} />
            <span class="nav-label">{t(item.key as any)}</span>
          </a>
        );
    })}


  </nav>
  
  <!-- Social Links -->
  <div class="social-links">
    <a href="https://github.com/AntonioWalter" target="_blank" rel="noopener" class="social-link" title="GitHub">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
      </svg>
    </a>
    <a href="https://www.linkedin.com/in/antonio-walter-de-fusco/" target="_blank" rel="noopener" class="social-link" title="LinkedIn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
        <rect x="2" y="9" width="4" height="12"/>
        <circle cx="4" cy="4" r="2"/>
      </svg>
    </a>
    <a href="mailto:antoniowalter@email.com" class="social-link" title="Email">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
    </a>
  </div>
</aside>

<!-- Mobile Top Bar Separate Component -->
<div class="mobile-top-bar">
  <span class="mobile-logo">AW</span>
  <div class="mobile-socials">
      <a href="https://github.com/AntonioWalter" target="_blank" rel="noopener" class="social-link-mobile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/antonio-walter-de-fusco/" target="_blank" rel="noopener" class="social-link-mobile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
      <a href="mailto:antoniowalter@email.com" class="social-link-mobile">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      </a>
  </div>
</div>

<style>
  /* Sidebar / Profile Card Styles */
  .profile-card {
    position: fixed;
    left: 80px; 
    top: 50%;
    transform: translateY(-50%);
    width: 320px;
    background: rgba(26, 26, 46, 0.85);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    backdrop-filter: blur(20px);
    box-shadow: 
      0 25px 50px rgba(0, 0, 0, 0.4),
      0 0 80px rgba(99, 102, 241, 0.15);
    z-index: 100;
    transition: all var(--transition-base);
  }
  
  .profile-card:hover {
    border-color: rgba(99, 102, 241, 0.4);
    box-shadow: 
      0 25px 50px rgba(0, 0, 0, 0.4),
      0 0 80px rgba(99, 102, 241, 0.15);
  }
  
  /* Profile Header */
  .profile-header {
    text-align: center;
    padding-bottom: var(--space-6);
    border-bottom: 1px solid rgba(99, 102, 241, 0.1);
    margin-bottom: var(--space-6);
  }
  
  .profile-image {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-3);
  }
  
  .profile-placeholder {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(99, 102, 241, 0.5);
    box-shadow: 0 0 40px rgba(99, 102, 241, 0.5);
    transition: transform var(--transition-base);
  }
  
  .profile-card:hover .profile-placeholder {
    transform: scale(1.05);
  }
  
  .profile-name {
    font-size: 1.35rem; 
    font-weight: 700;
    margin-bottom: var(--space-2);
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    white-space: nowrap; 
  }
  
  .profile-title {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  
  .profile-location {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  /* Desktop Language Switcher */
  .lang-switch-desktop {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .lang-btn {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s;
    padding: 2px 4px;
    border-radius: 4px;
  }

  .lang-btn:hover {
    color: white;
    background: rgba(255,255,255,0.05);
  }

  .lang-btn.active {
    color: var(--color-primary);
    background: rgba(99, 102, 241, 0.1);
  }

  .divider {
    color: rgba(255,255,255,0.2);
    font-size: 0.8em;
  }
  
  /* Navigation */
  .profile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  
  .nav-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    font-weight: 500;
    transition: all var(--transition-fast);
    text-decoration: none; /* Add this explicitly */
  }
  
  .nav-item:hover {
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-text-heading);
    transform: translateX(4px);
  }
  
  .nav-item.active {
    background: var(--gradient-primary);
    color: white;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
  }
  
  .nav-icon {
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile Language Toggle Icon text */
  .lang-text-icon {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    border: 1px solid rgba(99,102,241,0.3);
    border-radius: 4px;
    width: 28px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  /* Social Links */
  .social-links {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(99, 102, 241, 0.1);
  }
  
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-lg);
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }
  
  .social-link:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-2px);
  }
  
  /* Hide Mobile Lang Toggle on Desktop */
  .mobile-lang-toggle {
    display: none !important;
  }
  
  /* Mobile Top Bar Styles */
  .mobile-top-bar {
    display: none;
  }

  @media (max-width: 640px) {
    .mobile-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 60px;
      padding: 0 20px;
      background: #1a1a2e;
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(99, 102, 241, 0.2);
      z-index: 1001;
    }

    .mobile-logo {
      font-weight: 800;
      font-size: 1.2rem;
      background: var(--gradient-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .mobile-socials {
      display: flex;
      gap: 15px;
    }

    .social-link-mobile {
      color: var(--color-text-muted);
      transition: color 0.2s;
    }
    
    .social-link-mobile:hover {
      color: var(--color-primary);
    }
  }

  /* Responsive Sidebar Logic */
  @media (max-width: 1200px) {
    .profile-card {
      /* Reset fixed/sidebar positioning to Bottom Bar */
      position: fixed;
      left: 50%;
      top: auto;
      bottom: var(--space-4);
      transform: translateX(-50%);
      width: auto;
      max-width: 90%;
      padding: var(--space-4);
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }
    
    .profile-header {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      text-align: left;
      padding-bottom: 0;
      border-bottom: none;
      margin-bottom: 0;
      border-right: 1px solid rgba(99, 102, 241, 0.1);
      padding-right: var(--space-4);
    }
    
    .profile-image {
      margin-bottom: 0;
    }
    
    .profile-placeholder {
      width: 50px;
      height: 50px;
      font-size: 1.5rem;
    }
    
    .profile-location {
      display: none;
    }

    /* Hide Desktop Language Switcher on Mobile/Tablet */
    .lang-switch-desktop {
        display: none;
    }
    
    /* On tablet, keep icon+text but compact if needed */
    .profile-nav {
      flex-direction: row;
      gap: var(--space-1);
      margin-bottom: 0;
      border-right: 1px solid rgba(99, 102, 241, 0.1);
      padding-right: var(--space-4);
    }
    
    .nav-label {
      display: none; /* Hide labels on tablet to save space */
    }
    
    .nav-item {
      padding: var(--space-2);
    }
    
    /* Show Mobile Lang Toggle */
    .mobile-lang-toggle {
        display: flex !important;
    }

    .social-links {
      padding-top: 0;
      border-top: none;
    }
  }
  
  @media (max-width: 640px) {
    .profile-card {
      padding: var(--space-3);
      gap: var(--space-2);
      width: 90%;
      justify-content: center;
    }
    
    .profile-header {
      display: none;
    }
    
    .profile-nav {
      padding-right: 0;
      border-right: none;
      flex: 1;
      justify-content: space-around;
      /* Remove border */
      border: none;
    }

    .social-links {
        display: none; /* Hide social links on very small screens to prioritize nav */
    }
  }

  /* Easter Egg Styles */
  :global(.gravity-fall) {
    transform: translateY(120vh) rotate(10deg) scale(0.8) !important;
    opacity: 0 !important;
    transition: all 1.5s cubic-bezier(0.55, 0.055, 0.675, 0.19) !important;
    pointer-events: none !important;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }
</style>
