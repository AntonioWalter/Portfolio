---
import BaseLayout from '../layouts/BaseLayout.astro';
import CursorFollower from './CursorFollower';
import AnimatedBackground from './AnimatedBackground';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // Remove trailing slash
---

<BaseLayout title={`Antonio Walter De Fusco | ${t('role')}`} lang={lang}>
  <AnimatedBackground client:load />
  <CursorFollower client:load />
  
  <div class="home-container">
    
    <!-- 1. HERO SECTION: Clean, Immersive, Typographic -->
    <section class="hero-section">
      <div class="hero-content animate-fade-in-up">
        <div class="availability-badge">
          <span class="pulse-dot"></span>
          <span>{t('availability.open')}</span>
        </div>
        
        <h1 class="hero-title">
          {t('hero.title.part1')} <span class="gradient-text">{t('hero.title.part2')}</span><br />
          {t('hero.title.part3')}
        </h1>
        
        <p class="hero-bio" set:html={t('hero.bio')} />

        <div class="hero-actions">
          <a href={lang === 'it' ? `${base}/it/projects` : `${base}/projects`} class="btn-primary-glow">
            {t('hero.button')}
            <span class="arrow-icon">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. HIGHLIGHTS GRID: Large Glass Panels (Style similar to Skills) -->
    <section class="highlights-section animate-fade-in-up delay-200">
      
      <!-- HACKATHON HIGHLIGHT (Full Width) -->
      <a href={lang === 'it' ? `${base}/it/awards` : `${base}/awards`} class="highlight-card award">
        <div class="card-bg-glow gold"></div>
        <div class="highlight-content">
          <div class="highlight-icon-box">🏆</div>
          <div class="highlight-text">
            <span class="sub-label">{t('card.madeinitaly.sub')}</span>
            <h2>{t('card.madeinitaly.title')}</h2>
            <p>{t('card.madeinitaly.desc')}</p>
          </div>
        </div>
        <div class="highlight-arrow">↗</div>
      </a>

      <!-- FEATURED PROJECT & TECH (Split) -->
      <div class="split-row">
        <!-- Culturia Project -->
        <a href="https://github.com/AntonioWalter/Culturia" target="_blank" class="highlight-card project">
          <div class="card-bg-glow purple"></div>
          <div class="highlight-content">
            <div class="highlight-icon-box purple">🏛️</div>
            <div class="highlight-text">
              <span class="sub-label">{t('card.culturia.sub')}</span>
              <h2>{t('card.culturia.title')}</h2>
              <p>{t('card.culturia.desc')}</p>
            </div>
          </div>
          <div class="highlight-arrow">↗</div>
        </a>

        <!-- Sintonia Project -->
        <a href="https://github.com/gianfrancobarba/SINTONIA" target="_blank" class="highlight-card project">
          <div class="card-bg-glow emerald"></div>
          <div class="highlight-content">
            <div class="highlight-icon-box emerald">🧠</div>
            <div class="highlight-text">
              <span class="sub-label">{t('card.sintonia.sub')}</span>
              <h2>{t('card.sintonia.title')}</h2>
              <p>{t('card.sintonia.desc')}</p>
            </div>
          </div>
          <div class="highlight-arrow">↗</div>
        </a>
      </div>

    </section>

  </div>
</BaseLayout>

<style>
  /* CONTAINER & LAYOUT */
  .home-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px 20px;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  /* 1. HERO SECTION */
  .hero-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 50vh;
  }

  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 100px;
    color: #22d3ee;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 30px;
    width: fit-content;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 10px #22c55e;
    animation: pulse 2s infinite;
  }

  .hero-title {
    font-size: clamp(3rem, 7vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 25px;
    letter-spacing: -0.02em;
  }

  .hero-bio {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 600px;
    margin-bottom: 40px;
  }

  /* Removed local strong rule as set:html might handle it, or global applies */
  :global(.hero-bio strong) {
    color: white;
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    gap: 20px;
  }

  .btn-primary-glow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: var(--gradient-primary);
    color: white;
    font-weight: 600;
    font-size: 1.1rem;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
    transition: all 0.3s ease;
  }

  .btn-primary-glow:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(99, 102, 241, 0.4);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 16px 32px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: white;
    font-weight: 600;
    font-size: 1.1rem;
    border-radius: 16px;
    transition: all 0.3s;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* 2. HIGHLIGHTS SECTION */
  .highlights-section {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Common Card Style (Premium Glass) */
  .highlight-card {
    position: relative;
    background: rgba(20, 20, 30, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08); /* Bordo sottile elegante */
    border-radius: 32px; /* Molto arrotondato */
    padding: 40px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .highlight-card:hover {
    transform: translateY(-8px);
    background: rgba(30, 30, 45, 0.8);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 40px 80px rgba(0,0,0,0.5); /* Ombra profonda */
  }

  /* Glow effects */
  .card-bg-glow {
    position: absolute;
    top: 0; right: 0;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.15;
    transition: opacity 0.4s;
  }
  .highlight-card:hover .card-bg-glow { opacity: 0.3; }

  .gold { background: #fbbf24; }
  .purple { background: #a855f7; }
  .cyan { background: #22d3ee; }
  .emerald { background: #10b981; }

  /* Content Layouts */
  .highlight-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 30px;
    padding-right: 50px; /* Prevent overlap with arrow */
  }
  
  .highlight-content.vertical {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  /* Typography inside cards */
  .sub-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.5);
    margin-bottom: 8px;
    display: block;
  }

  .highlight-card h2 {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 8px 0;
  }

  .highlight-card p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin: 0;
  }

  /* Icon Box */
  .highlight-icon-box {
    width: 80px;
    height: 80px;
    flex-shrink: 0; /* Prevent squashing in smaller containers */
    background: rgba(251, 191, 36, 0.1);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    transition: transform 0.3s ease;
  }
  
  .highlight-icon-box.purple {
    background: rgba(168, 85, 247, 0.15); /* Purple tint */
  }

  .highlight-card:hover .highlight-icon-box {
    transform: rotate(10deg) scale(1.1);
  }
  
  .highlight-card:hover .highlight-icon-box.purple {
    background: rgba(168, 85, 247, 0.25);
  }

  .highlight-icon-box.emerald {
    background: rgba(16, 185, 129, 0.15); /* Emerald tint */
  }

  .highlight-card:hover .highlight-icon-box.emerald {
    background: rgba(16, 185, 129, 0.25);
  }

  .highlight-arrow {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    transition: all 0.3s;
    background: rgba(20, 20, 30, 0.6);
    z-index: 20;
    pointer-events: none;
  }
  .highlight-card:hover .highlight-arrow {
    background: white;
    color: black;
    transform: rotate(45deg);
  }

  /* Split Row Items */
  .split-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .split-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 2.5rem; }
    .hero-actions { flex-direction: column; }
    .highlight-content { flex-direction: column; text-align: center; }
    
    .highlight-arrow {
      bottom: auto;
      top: 20px;
      right: 20px;
    }
  }
</style>
