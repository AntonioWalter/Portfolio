---
import BaseLayout from '../layouts/BaseLayout.astro';
import GitHubStats from './GitHubStats.astro';
import CursorFollower from './CursorFollower';
import AnimatedBackground from './AnimatedBackground';
import TechMarquee from './TechMarquee.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={`${t('skills.title_highlight')} | Antonio Walter De Fusco`} lang={lang}>
  <AnimatedBackground client:load />
  <CursorFollower client:load />

  <div class="page-container">
    <header class="page-header">
      <h1>{t('skills.title')} <span class="gradient-text">{t('skills.title_highlight')}</span></h1>
      <p>{t('skills.subtitle')}</p>
    </header>

    <!-- MARQUEE TOP -->
    <section class="marquee-section">
      <TechMarquee />
    </section>

    <!-- BENTO GRID -->
    <div class="bento-grid">
      
      <!-- COL 1: GITHUB STATS -->
      <section class="bento-card github-section">
        <div class="card-bg-glow purple"></div>
        <div class="card-header">
          <h2>GitHub Stats</h2>
        </div>
        <div class="stats-wrapper">
          <GitHubStats username="AntonioWalter" />
        </div>
      </section>

      <!-- COL 2: FOCUS & GOALS -->
      <section class="bento-card focus-section">
        <div class="card-bg-glow blue"></div>
        <div class="card-header">
          <h2>Soft Skills</h2>
        </div>
        
        <div class="focus-content">
          <p>{t('skills.soft.intro')}</p>
          
          <div class="soft-skills-list">
            <div class="soft-skill-item">
              <span class="icon">🗣️</span>
              <span>{t('skills.soft.comm')}</span>
            </div>
            <div class="soft-skill-item">
              <span class="icon">🤝</span>
              <span>{t('skills.soft.team')}</span>
            </div>
            <div class="soft-skill-item">
              <span class="icon">🧩</span>
              <span>{t('skills.soft.prob')}</span>
            </div>
            <div class="soft-skill-item">
              <span class="icon">⏱️</span>
              <span>{t('skills.soft.time')}</span>
            </div>
          </div>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px 20px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .page-header h1 {
    font-size: clamp(3rem, 6vw, 4rem);
    font-weight: 800;
    margin-bottom: 8px;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  /* BENTO GRID */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Equal width columns */
    gap: 24px;
    margin-bottom: 40px;
  }

  .bento-card {
    position: relative;
    background: rgba(20, 20, 30, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    padding: 30px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .bento-card:hover {
    transform: translateY(-8px);
    background: rgba(30, 30, 45, 0.8);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 30px 60px rgba(0,0,0,0.4);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
    z-index: 2;
  }

  /* GLOW HOVER */
  .bento-card:hover .card-bg-glow {
    opacity: 0.3;
  }

  .bento-card h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  /* FOCUS SECTION */
  .focus-content p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 24px;
    z-index: 2;
    position: relative;
  }

  .soft-skills-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    z-index: 2;
    position: relative;
  }

  .soft-skill-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    padding: 20px;
    background: rgba(30, 30, 45, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    transition: all 0.3s;
    width: 100%;
    height: 140px; /* Uniform height for all items */
    /* aspect-ratio removed to prevent excessive height */
  }

  .soft-skill-item:hover {
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.3);
    transform: translateY(-4px);
  }
  
  .soft-skill-item .icon {
    font-size: 2rem;
    margin-bottom: 4px;
  }

  /* MARQUEE SECTION */
  .marquee-section {
    width: 100%;
    position: relative;
    margin-bottom: 40px;
  }

  /* GLOW */
  .card-bg-glow {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at top right, var(--glow-color, rgba(255,255,255,0.05)), transparent 70%);
    opacity: 0.1;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .purple { --glow-color: #a855f7; }
  .blue { --glow-color: #3b82f6; }

  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
