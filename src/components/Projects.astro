---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedBackground from './AnimatedBackground';
import CursorFollower from './CursorFollower';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = [
  {
    title: 'Signify',
    description: t('project.signify.desc'),
    tags: ['Deep Learning', 'MediaPipe', 'Python'],
    icon: '👋',
    color: 'orange',
    category: 'University | AI Research',
    link: 'https://github.com/AntonioWalter/Signify'
  },
  {
    title: 'SINTON-IA',
    description: t('project.sintonia_ia.desc'),
    tags: ['NLP', 'Genetic Algorithm', 'FastAPI'],
    icon: '🧠',
    color: 'red',
    category: 'University | AI Research',
    link: 'https://github.com/AntonioWalter/SINTON-IA'
  },
  {
    title: 'VerIta',
    description: t('project.verita.desc'),
    tags: ['RFID', 'Web App', 'Typescript'],
    icon: '🇮🇹',
    color: 'gold', 
    category: 'Hackathon',
    link: 'https://github.com/AntonioWalter/verITA'
  },
  {
    title: 'Sintonia',
    description: t('project.sintonia.desc'),
    tags: ['Salute Mentale', 'React', 'NestJS'],
    icon: '🧠',
    color: 'emerald',
    category: 'University',
    link: 'https://github.com/gianfrancobarba/SINTONIA'
  },
  {
    title: 'Tree-Time',
    description: t('project.treetime.desc'),
    tags: ['JSP', 'HTML', 'CSS'],
    icon: '🌳',
    color: 'green',
    category: 'University',
    link: 'https://github.com/AntonioWalter/Tree-Time'
  },
  {
    title: 'Culturia',
    description: t('project.culturia.desc'),
    tags: ['Usabilità', 'Figma', 'LaTeX'],
    icon: '🏛️',
    color: 'purple',
    category: 'Hackathon',
    link: 'https://github.com/AntonioWalter/Culturia'
  },
  {
    title: 'Tennis Management System',
    description: t('project.tennis.desc'),
    tags: ['Java', 'Desktop', 'SQL'],
    icon: '🎾',
    color: 'blue',
    category: 'University',
    link: 'https://github.com/AntonioWalter/tennis-management-system'
  }
];
---

<BaseLayout title={`${t('projects.title_highlight')} | Antonio Walter De Fusco`} lang={lang}>
  <AnimatedBackground client:load />
  <CursorFollower client:load />

  <div class="page-container">
    <header class="page-header">
      <h1>{t('projects.title')} <span class="gradient-text">{t('projects.title_highlight')}</span></h1>
      <p>{t('projects.subtitle')}</p>
    </header>

    <div class="projects-grid">
      {projects.map((project) => (
        <a href={project.link} class="project-card" target="_blank" rel="noopener noreferrer">
          <div class={`card-bg-glow ${project.color}`}></div>
          <div class="card-content">
            <div class="top-row">
              <span class="tag">{project.category}</span>
              <div class="icon-box">{project.icon}</div>
            </div>
            
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            
            <div class="bottom-row">
              <div class="tech-stack">
                {project.tags.map(tag => <span>{tag}</span>)}
              </div>
              <div class="arrow">↗</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px 20px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .page-header h1 {
    font-size: clamp(3rem, 6vw, 4rem);
    font-weight: 800;
    margin-bottom: 10px;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.2rem;
  }

  /* GRID SYSTEM */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  /* CARD STYLE (Clone della Home) */
  .project-card {
    position: relative;
    background: rgba(20, 20, 30, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08); /* Bordo sottile elegante */
    border-radius: 32px;
    padding: 30px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    min-height: 280px;
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    transform: translateY(-8px);
    background: rgba(30, 30, 45, 0.8);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 30px 60px rgba(0,0,0,0.4);
  }

  /* GLOW */
  .card-bg-glow {
    position: absolute;
    top: 0; right: 0;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.1;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .project-card:hover .card-bg-glow { opacity: 0.25; }

  .orange { background: #f97316; }
  .red { background: #ef4444; }
  .gold { background: #fbbf24; }
  .green { background: #22c55e; }
  .purple { background: #a855f7; }
  .blue { background: #3b82f6; }
  .emerald { background: #10b981; }

  /* CONTENT */
  .card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }

  .tag {
    padding: 6px 14px;
    background: rgba(255,255,255,0.08);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    height: fit-content;
  }

  .icon-box {
    width: 60px;
    height: 60px;
    background: rgba(255,255,255,0.05);
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    border: 1px solid rgba(255,255,255,0.05);
    transition: transform 0.3s ease;
  }

  .project-card:hover .icon-box {
    transform: rotate(10deg) scale(1.1);
  }

  h2 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  p {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: auto; /* Spinge footer in basso */
    padding-bottom: 20px;
  }

  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-top: 20px;
  }

  .tech-stack {
    display: flex;
    gap: 8px;
  }

  .tech-stack span {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.6);
  }

  .arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
  }

  .project-card:hover .arrow {
    background: white;
    color: black;
    transform: rotate(45deg);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
