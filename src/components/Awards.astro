---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedBackground from './AnimatedBackground';
import CursorFollower from './CursorFollower';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'it' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const awards = [
  {
    title: t('award.mic.title'),
    event: t('award.mic.event'),
    organizer: 'Zecca dello Stato & Codemotion',
    description: t('award.mic.desc'),
    tags: ['2° Place', 'RFId', 'Typescript'],
    icon: '🇮🇹',
    color: 'gold',
    featured: true,
    year: '2024'
  },
  {
    title: t('award.hack.title'),
    event: t('award.hack.event'),
    organizer: 'Hackcultura',
    description: t('award.hack.desc'),
    tags: ['IUM', 'Figma', 'Usabilità'],
    icon: '🏛️',
    color: 'purple',
    featured: false,
    year: '2025'
  }
];
---

<BaseLayout title={`${t('awards.title_highlight')} | Antonio Walter De Fusco`} lang={lang}>
  <AnimatedBackground client:load />
  <CursorFollower client:load />

  <div class="page-container">
    <header class="page-header">
      <h1>{t('awards.title')} <span class="gradient-text">{t('awards.title_highlight')}</span></h1>
      <p>{t('awards.subtitle')}</p>
    </header>

    <div class="awards-grid">
      {awards.map((award) => (
        <a href="https://www.linkedin.com/in/antonio-walter-de-fusco/" target="_blank" rel="noopener noreferrer" class="award-card">
          <div class={`card-bg-glow ${award.color}`}></div>
          <div class="card-content">
            <div class="top-row">
              <span class="tag">{award.event}</span>
              <span class="year-badge">{award.year}</span>
            </div>
            
            <div class="icon-section">
              <div class="icon-box">{award.icon}</div>
            </div>

            <div class="info-section">
              <h2>{award.title}</h2>
              <p class="organizer">{award.organizer}</p>
              <p class="desc">{award.description}</p>
            </div>
            
            <div class="bottom-row">
              <div class="award-tags">
                {award.tags.map(tag => <span>{tag}</span>)}
              </div>
              <div class="arrow">↗</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px 20px;
  }

  .page-header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .page-header h1 {
    font-size: clamp(3rem, 6vw, 4rem);
    font-weight: 800;
    margin-bottom: 10px;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.2rem;
  }

  /* GRID SYSTEM */
  .awards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 50px;
  }

  /* CARD STYLE */
  .award-card {
    position: relative;
    background: rgba(20, 20, 30, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    padding: 30px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    min-height: 320px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .award-card:hover {
    transform: translateY(-8px);
    background: rgba(30, 30, 45, 0.8);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 30px 60px rgba(0,0,0,0.4);
  }

  /* GLOW */
  .card-bg-glow {
    position: absolute;
    top: -50px; right: -50px;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .award-card:hover .card-bg-glow { opacity: 0.3; }

  .gold { background: #fbbf24; }
  .purple { background: #a855f7; }

  /* CONTENT */
  .card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .tag {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .year-badge {
    padding: 4px 10px;
    background: rgba(255,255,255,0.05);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .icon-section {
    margin-bottom: 20px;
  }

  .icon-box {
    width: 70px;
    height: 70px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    transition: transform 0.4s;
  }

  .award-card:hover .icon-box {
    transform: rotate(10deg) scale(1.1);
    background: rgba(255,255,255,0.08);
  }

  .info-section h2 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 4px;
    line-height: 1.2;
  }

  .organizer {
    color: var(--color-primary-light);
    font-size: 0.9rem;
    margin-bottom: 12px;
  }

  .desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: auto;
    white-space: pre-line;
  }

  .bottom-row {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    font-size: 1.2rem;
  }

  .award-card:hover .arrow {
    background: white;
    color: black;
    transform: rotate(45deg);
  }

  .award-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .award-tags span {
    padding: 6px 12px;
    background: rgba(255,255,255,0.05);
    border-radius: 8px;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.8);
  }

  @media (max-width: 768px) {
    .awards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
